# Copy to .env.local (dev) and .env.test (tests; database name must end in _test).
DATABASE_URL=mysql://user:password@127.0.0.1:3306/pmp_practice
# Random string for signing login cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me
# Initial password of admin@dump-exam.local, used only by `npm run db:seed` when the Admin does not exist yet.
ADMIN_PASSWORD=change-me
