{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "e2e": "node --env-file=.env.test node_modules/@playwright/test/cli.js test",
    "test": "tsx --env-file=.env.test --test --test-concurrency=1 'tests/**/*.test.ts'",
    "tags:split": "tsx scripts/tags.ts split",
    "tags:merge": "tsx scripts/tags.ts merge",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "audit": "python3 -I scripts/audit_answers.py \"${HTML:-$HOME/Desktop/PMP_examtopic.html}\" data/questions.json && tsx --env-file=.env.local scripts/audit_db.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.53.0",
    "mysql2": "^3.24.5",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
